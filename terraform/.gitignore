Set-Content -Path .gitignore -Value @"
# Dependencies
node_modules/
dist/
build/

# Private Keys & Secrets (CRITICAL)
*.pem
*.key
ec2_key
**/ec2_key
.env

# Terraform heavy binaries & state
.terraform/
**/.terraform/
*.tfstate
*.tfstate.*
*.exe
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
"@